{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/recommendation_canary_writer.v1.proposal.json",
  "title": "Recommendation Phase 1 canary writer proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": ["writer_id", "writer_revision", "environment", "principal_ref", "target_binding_ref", "candidate_ref", "review_ref", "bridge_ref", "release_ref", "operation_id", "idempotency_key", "allowed_fields", "protected_fields", "max_operations", "readback_required", "audit_required", "kill_switch_required", "retry_policy", "result_state", "created_at", "semantic_hash"],
  "properties": {
    "writer_id": {"const": "recommendation-canary-writer"},
    "writer_revision": {"type": "integer", "minimum": 1},
    "environment": {"const": "UAT"},
    "principal_ref": {"type": "string", "minLength": 1},
    "target_binding_ref": {"type": "string", "minLength": 1},
    "candidate_ref": {"type": "object"},
    "review_ref": {"type": "object"},
    "bridge_ref": {"type": "object"},
    "release_ref": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "allowed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "protected_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "max_operations": {"const": 1},
    "readback_required": {"const": true},
    "audit_required": {"const": true},
    "kill_switch_required": {"const": true},
    "retry_policy": {"const": "NO_AUTOMATIC_RETRY_UNKNOWN_RESULT"},
    "result_state": {"enum": ["PLANNED", "BLOCKED", "WRITE_INTENT_READY", "TRANSPORT_SUCCEEDED", "TRANSPORT_UNKNOWN", "READBACK_MATCHED", "READBACK_MISMATCH", "RECONCILED_SUCCESS", "RECONCILIATION_CONFLICT", "AUDIT_PERSISTED", "CANARY_COMPLETE", "SAFE_TO_RETRY_REQUIRES_HUMAN_AUTHORIZATION"]},
    "created_at": {"type": "string", "format": "date-time"},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "x-proposal-status": {"const": "DRAFT_NOT_APPROVED"},
    "x-production-activation": {"const": false}
  },
  "additionalProperties": false
}
