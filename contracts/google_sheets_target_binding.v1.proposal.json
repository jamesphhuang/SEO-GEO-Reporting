{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/google_sheets_target_binding.v1.proposal.json",
  "title": "Google Sheets Recommendation canary target binding proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": ["binding_id", "environment", "workbook_id_ref", "tab_name", "allowed_fields", "protected_fields", "writer_principal_ref", "readback_required", "max_operations", "created_at", "semantic_hash"],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "environment": {"const": "UAT"},
    "workbook_id_ref": {"type": "string", "minLength": 1},
    "tab_name": {"const": "Opportunity_Recommendations"},
    "allowed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "protected_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "writer_principal_ref": {"type": "string", "minLength": 1},
    "readback_required": {"const": true},
    "max_operations": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "x-proposal-status": {"const": "DRAFT_NOT_APPROVED"},
    "x-production-activation": {"const": false}
  },
  "additionalProperties": false
}
