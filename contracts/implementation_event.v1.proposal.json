{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/implementation_event.v1.proposal.json",
  "title": "Offline implementation event proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": ["record_type", "contract_version", "implementation_event_id", "revision", "candidate_id", "candidate_revision", "candidate_hash", "review_id", "review_revision", "review_hash", "bridge_id", "bridge_revision", "bridge_hash", "action", "event_type", "completed_at", "deployment_ref", "change_ref", "production_mutation", "created_at", "content_hash"],
  "properties": {
    "record_type": {"const": "IMPLEMENTATION_EVENT"},
    "contract_version": {"const": "implementation_event.v1.proposal"},
    "implementation_event_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_implementation_revision": {"type": ["integer", "null"], "minimum": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "candidate_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_id": {"type": "string", "minLength": 1},
    "review_revision": {"type": "integer", "minimum": 1},
    "review_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bridge_id": {"type": "string", "minLength": 1},
    "bridge_revision": {"type": "integer", "minimum": 1},
    "bridge_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action": {"type": "string", "minLength": 1},
    "target_url": {"type": ["string", "null"]},
    "event_type": {"enum": ["IMPLEMENTED", "CANCELLED", "MONITORING_ONLY"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "deployment_ref": {"type": "string", "minLength": 1},
    "change_ref": {"type": "string", "minLength": 1},
    "human_execution_owner": {"type": ["string", "null"]},
    "production_mutation": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
