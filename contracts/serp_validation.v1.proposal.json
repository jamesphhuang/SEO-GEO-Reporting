{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/serp_validation.v1.proposal.json",
  "title": "SERP validation proposal",
  "description": "Shortlist-only, observed SERP interpretation. Proposal contract; not production activated.",
  "type": "object",
  "additionalProperties": false,
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "x-source-role": "LIVE / OBSERVED SERP VALIDATION EVIDENCE",
  "required": ["record_type", "contract_version", "validation_id", "revision", "candidate_id", "candidate_revision", "topic_cluster_id", "target_url", "validation_status", "serp_evidence_refs", "candidate_evidence_refs", "freshness", "approval_transition_allowed", "content_hash", "created_at", "updated_at"],
  "properties": {
    "record_type": {"const": "SERP_VALIDATION"},
    "contract_version": {"const": "serp_validation.v1.proposal"},
    "validation_id": {"type": "string", "pattern": "^SV_[A-Za-z0-9._:-]+$"},
    "revision": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "topic_cluster_id": {"type": "string", "minLength": 1},
    "opportunity_type": {"type": "string"},
    "recommended_action": {"type": "string"},
    "target_url": {"type": "string", "format": "uri"},
    "canonical_url_id": {"type": ["string", "null"]},
    "existing_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "validation_query_ref": {"type": ["object", "null"]},
    "validation_query_text": {"type": ["string", "null"]},
    "serp_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "candidate_evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceRef"}},
    "validation_status": {"enum": ["SERP_VALIDATED", "SERP_CONFLICT", "SERP_NOT_CHECKED"]},
    "observed_intent": {"enum": ["INFORMATIONAL", "COMMERCIAL_INVESTIGATION", "TRANSACTIONAL", "NAVIGATIONAL", "MIXED", "UNKNOWN"]},
    "expected_intent": {"type": "string"},
    "page_type_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "owned_presence": {"enum": ["PRESENT", "ABSENT", "NOT_AVAILABLE", "UNKNOWN"]},
    "competitor_presence": {"type": "array", "items": {"type": "string"}},
    "unknown_domains": {"type": "array", "items": {"type": "string"}},
    "serp_features": {"type": "object", "additionalProperties": {"enum": ["OBSERVED", "NOT_OBSERVED", "NOT_AVAILABLE"]}},
    "conflict_reasons": {"type": "array", "items": {"type": "string"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "freshness": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "revision", "period_end", "as_of", "retrieved_at", "freshness_state", "collection_status", "is_current"], "properties": {"evidence_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "period_end": {"type": ["string", "null"], "format": "date"}, "as_of": {"type": ["string", "null"], "format": "date"}, "retrieved_at": {"type": ["string", "null"], "format": "date-time"}, "freshness_state": {"type": ["string", "null"]}, "collection_status": {"type": ["string", "null"]}, "is_current": {"type": "boolean"}}, "additionalProperties": false}},
    "serp_scope": {"type": "object", "required": ["country", "locale", "device", "search_scope"], "properties": {"country": {"type": ["string", "null"]}, "locale": {"type": ["string", "null"]}, "device": {"type": "string"}, "search_scope": {"type": "string"}}, "additionalProperties": false},
    "rule_trace": {"type": "array", "items": {"type": "object", "required": ["rule_id", "rule_version", "matched_conditions", "failed_conditions", "snapshot_refs", "candidate_refs"], "properties": {"rule_id": {"type": "string"}, "rule_version": {"type": "string"}, "matched_conditions": {"type": "array", "items": {"type": "string"}}, "failed_conditions": {"type": "array", "items": {"type": "string"}}, "snapshot_refs": {"type": "array"}, "candidate_refs": {"type": "array"}}, "additionalProperties": false}},
    "snapshot_hashes": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "validation_confidence": {"enum": ["HIGH", "MEDIUM", "LOW", "NOT_ASSESSABLE"]},
    "wp5_score": {"type": ["integer", "null"]},
    "wp5_confidence": {"type": ["string", "null"]},
    "candidate_status": {"type": "string"},
    "candidate_review_state": {"type": "string"},
    "approval_transition_allowed": {"const": false},
    "ga4_diagnostic": {"type": ["object", "null"]},
    "input_signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {"evidenceRef": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "revision", "content_hash"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
}
