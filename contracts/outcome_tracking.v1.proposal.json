{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/outcome_tracking.v1.proposal.json",
  "title": "Offline opportunity outcome tracking proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": ["record_type", "contract_version", "outcome_track_id", "revision", "candidate_id", "candidate_revision", "candidate_hash", "review_id", "review_revision", "review_hash", "bridge_id", "bridge_revision", "bridge_hash", "implementation_event_id", "implementation_revision", "implementation_hash", "action", "completed_at", "checkpoint", "checkpoint_due_date", "tracking_status", "formal_evaluation", "outcome_state", "measurement_plan", "baseline_window", "follow_up_window", "baseline_observations", "follow_up_observations", "comparisons", "evidence_refs", "missing_metrics", "conflicts", "limitations", "causal_claim", "production_mutation", "policy_version", "evaluated_at", "created_at", "content_hash"],
  "properties": {
    "record_type": {"const": "OUTCOME_TRACK"},
    "contract_version": {"const": "outcome_tracking.v1.proposal"},
    "outcome_track_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes_outcome_revision": {"type": ["integer", "null"], "minimum": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "candidate_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_id": {"type": "string", "minLength": 1},
    "review_revision": {"type": "integer", "minimum": 1},
    "review_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bridge_id": {"type": "string", "minLength": 1},
    "bridge_revision": {"type": "integer", "minimum": 1},
    "bridge_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "implementation_event_id": {"type": "string", "minLength": 1},
    "implementation_revision": {"type": "integer", "minimum": 1},
    "implementation_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "action": {"type": "string", "minLength": 1},
    "target_url": {"type": ["string", "null"]},
    "completed_at": {"type": "string", "format": "date-time"},
    "checkpoint": {"enum": ["30D", "60D", "90D"]},
    "checkpoint_due_date": {"type": "string", "format": "date"},
    "tracking_status": {"enum": ["EVALUATED", "NOT_ELIGIBLE", "OBSERVATION_ONLY"]},
    "formal_evaluation": {"type": "boolean"},
    "outcome_state": {"enum": ["WON", "PARTIAL_WIN", "NO_CHANGE", "LOST", "INSUFFICIENT_DATA"]},
    "measurement_plan": {"type": "object", "required": ["primary_metric", "target_delta", "tolerance", "minimum_sample", "comparison_method", "direction", "support_metrics", "guardrails", "scope", "attribution_limitations"], "properties": {"primary_metric": {"type": "string", "minLength": 1}, "target_delta": {"type": "number"}, "tolerance": {"type": "number", "minimum": 0}, "minimum_sample": {"type": "integer", "minimum": 1}, "comparison_method": {"enum": ["RELATIVE_DELTA", "ABSOLUTE_DELTA"]}, "direction": {"enum": ["INCREASE", "DECREASE", "STABLE"]}, "support_metrics": {"type": "array", "items": {"type": "string"}}, "guardrails": {"type": "array"}, "scope": {"type": "string"}, "source_population": {"type": ["string", "null"]}, "attribution_limitations": {"type": "array", "items": {"type": "string"}}, "planned_effort": {"type": ["string", "null"]}, "attribution_contract_ref": {"type": ["string", "null"]}}, "additionalProperties": false},
    "baseline_window": {"$ref": "#/$defs/window"},
    "follow_up_window": {"$ref": "#/$defs/window"},
    "baseline_observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "follow_up_observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "comparisons": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/pin"}, "uniqueItems": true},
    "missing_metrics": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "primary_metric": {"type": "string", "minLength": 1},
    "support_metrics": {"type": "array", "items": {"type": "string"}},
    "candidate_score": {},
    "candidate_confidence": {"type": ["string", "null"]},
    "human_review_decision": {"type": ["string", "null"]},
    "bridge_status": {"type": ["string", "null"]},
    "observed_outcome_text": {"type": "string", "maxLength": 1000},
    "causal_claim": {"const": false},
    "production_mutation": {"const": false},
    "policy_version": {"type": "string", "minLength": 1},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "pin": {"type": "object", "required": ["evidence_id", "revision", "content_hash"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}, "additionalProperties": false},
    "window": {"type": "object", "required": ["period_start", "period_end", "timezone", "complete_days"], "properties": {"period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}, "timezone": {"const": "Asia/Taipei"}, "complete_days": {"const": 28}}, "additionalProperties": false},
    "observation": {"type": "object", "required": ["metric", "source", "source_role", "value", "period_start", "period_end", "evidence_ref", "status", "freshness_state", "scope", "timezone"], "properties": {"metric": {"type": "string", "minLength": 1}, "source": {"type": "string"}, "source_role": {"type": "string"}, "value": {"type": ["number", "null"]}, "period_start": {"type": "string", "format": "date"}, "period_end": {"type": "string", "format": "date"}, "evidence_ref": {"$ref": "#/$defs/pin"}, "status": {"type": "string"}, "freshness_state": {"type": "string"}, "unit": {"type": ["string", "null"]}, "scope": {"type": "string"}, "entity_ref": {"type": ["string", "null"]}, "source_population": {"type": ["string", "null"]}, "methodology": {"type": ["string", "null"]}, "sample_size": {"type": ["integer", "null"], "minimum": 0}, "timezone": {"type": "string"}, "sample_version": {"type": ["string", "null"]}, "sample_revision": {"type": ["integer", "null"], "minimum": 1}}, "additionalProperties": false}
  }
}
