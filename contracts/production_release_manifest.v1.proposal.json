{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/production_release_manifest.v1.proposal.json",
  "title": "Offline production release manifest proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": [
    "record_type", "contract_version", "release_id", "revision", "main_sha",
    "wp_versions", "contract_versions", "test_result_summary", "required_gates", "gate_results", "activation_status",
    "activation_state", "approved_writers", "scheduler_state", "production_write_ready", "production_activation_readiness", "known_policy_gaps",
    "known_source_gaps", "rollback_instructions", "planned_operations",
    "blocked_operations", "observability_events", "production_mutation",
    "actual_write_count", "created_at", "semantic_hash"
  ],
  "properties": {
    "record_type": {"const": "PRODUCTION_RELEASE_MANIFEST"},
    "contract_version": {"const": "production_release_manifest.v1.proposal"},
    "release_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "main_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "wp_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "contract_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "test_result_summary": {"type": "object", "required": ["status", "suites"], "properties": {"status": {"enum": ["PASS", "FAIL", "BLOCKED"]}, "suites": {"type": "object", "minProperties": 1}}, "additionalProperties": true},
    "required_gates": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "gate_results": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "activation_status": {"enum": ["DRY_RUN_VALIDATION_READY", "DRY_RUN_VALIDATION_BLOCKED", "DRY_RUN_READY", "DRY_RUN_BLOCKED", "BLOCKED", "FAILED", "PARTIAL"]},
    "activation_state": {"enum": ["DRY_RUN", "NOT_AUTHORIZED", "BLOCKED", "REVOKED", "DISABLED"]},
    "approved_writers": {"type": "array", "items": {"type": "string"}},
    "scheduler_state": {"const": "DISABLED"},
    "production_write_ready": {"const": false},
    "production_activation_readiness": {"const": "NOT_AUTHORIZED"},
    "known_policy_gaps": {"type": "array", "items": {"type": "string"}},
    "known_source_gaps": {"type": "array", "items": {"type": "string"}},
    "rollback_instructions": {"type": "object", "required": ["rollback_id", "release_id", "disable_new_writes", "disable_future_writes", "kill_switch", "scheduler_disable_required", "history_policy", "supersede_strategy", "reason", "readback_required", "status"], "properties": {"rollback_id": {"type": "string"}, "release_id": {"type": "string"}, "disable_new_writes": {"const": true}, "disable_future_writes": {"const": true}, "kill_switch": {"type": "string"}, "scheduler_disable_required": {"const": true}, "history_policy": {"type": "string"}, "supersede_strategy": {"type": "string"}, "reason": {"type": "string", "minLength": 1}, "readback_required": {"const": true}, "status": {"const": "PLANNED"}}, "additionalProperties": true},
    "planned_operations": {"type": "array", "items": {"type": "object"}},
    "blocked_operations": {"type": "array", "items": {"type": "object"}},
    "observability_events": {"type": "array", "items": {"type": "object"}},
    "production_mutation": {"const": 0},
    "actual_write_count": {"const": 0},
    "created_at": {"type": "string", "format": "date-time"},
    "x-proposal-status": {"const": "DRAFT_NOT_APPROVED"},
    "x-production-activation": {"const": false},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
