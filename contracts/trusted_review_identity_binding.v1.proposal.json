{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/trusted_review_identity_binding.v1.proposal.json",
  "title": "Phase 1 trusted review identity binding proposal",
  "type": "object",
  "x-proposal-status": "DRAFT_NOT_APPROVED",
  "x-production-activation": false,
  "required": ["binding_version", "provider", "reviewer_subject_ref", "workspace_domain", "role", "scope", "status", "binding_revision", "provider_verification_method", "same_person_writer_reviewer", "production_inheritance", "automatic_scope_expansion", "verified_at", "semantic_hash"],
  "properties": {
    "binding_version": {"const": "trusted-review-identity-binding.v1"},
    "provider": {"const": "GOOGLE_WORKSPACE"},
    "reviewer_subject_ref": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workspace_domain": {"const": "shopline.com"},
    "role": {"const": "RECOMMENDATION_APPROVER"},
    "scope": {"const": "PHASE1_CANARY"},
    "status": {"const": "ACTIVE"},
    "binding_revision": {"type": "integer", "minimum": 1},
    "provider_verification_method": {"const": "GOOGLE_OIDC_ID_TOKEN_V1"},
    "same_person_writer_reviewer": {"type": "boolean"},
    "separation_of_duties_waiver": {"type": ["string", "null"], "enum": ["APPROVED_PHASE1_CANARY_ONLY", null]},
    "production_inheritance": {"const": false},
    "automatic_scope_expansion": {"const": false},
    "verified_at": {"type": "string", "format": "date-time"},
    "semantic_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "x-proposal-status": {"const": "DRAFT_NOT_APPROVED"},
    "x-production-activation": {"const": false}
  },
  "additionalProperties": false
}
