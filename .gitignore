# Local credentials and OAuth tokens
.gsc-mcp-config/
.ga4-mcp-config/
gsc_credentials/*.json

# Rebuildable dependencies and tool caches
.venv-*/
node_modules
.screaming-frog-mcp/cache/
.screaming-frog-mcp/.cache/

# macOS metadata
.DS_Store
._*

# Rendered previews: preview_local.py rewrites these on every run, and the entire
# payload sits on one line, so the diff is a single unreviewable +1/-1. Rebuild them
# with `python3 preview_local.py [--exec]` instead of tracking them.
outputs/*/preview*.html

# Apps Script deploy bundles: a zip of files already tracked under apps_script/.
# Git cannot diff it, and it silently drifted from source once already. Rebuild it
# from apps_script/ when a deployment needs one.
outputs/*/*AppsScript*.zip

outputs/phase1_4_2026-09-05/
outputs/project_review_2026-09-05/
outputs/business_actual_import_preview_*/
__pycache__/
*.py[cod]
